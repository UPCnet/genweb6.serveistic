<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  i18n_domain="genweb">

  <genericsetup:upgradeStep
      title="Reimport genweb6.serveistic profile"
      description="Reimport profile steps and reindex servei_facetas"
      source="*"
      destination="*"
      handler="genweb6.serveistic.upgrades.upgrade_import_profile"
      profile="genweb6.serveistic:default"
      />

</configure>
