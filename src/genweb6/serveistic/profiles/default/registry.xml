<?xml version="1.0"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n">

  <records
    interface="Products.CMFPlone.interfaces.IBundleRegistry"
    prefix="plone.bundles/serveistic-bundle">

    <value key="enabled">True</value>
    <value key="compile">True</value>
    <value key="resources">
      <element>serveistic-main</element>
    </value>
    <value key="jscompilation" />
    <value key="csscompilation">++theme++genweb6.serveistic/stylesheets/theme-serveistic.min.css</value>

  </records>

  <record name="plone.sitemap_depth" interface="plone.base.interfaces.controlpanel.INavigationSchema" field="sitemap_depth">
    <field type="plone.registry.field.Int">
      <default>3</default>
      <description xmlns:ns0="http://xml.zope.org/namespaces/i18n" ns0:domain="plone" ns0:translate="">Number of folder levels to show in the site map.</description>
      <title xmlns:ns0="http://xml.zope.org/namespaces/i18n" ns0:domain="plone" ns0:translate="">Sitemap depth</title>
    </field>
    <value>2</value>
  </record>

  <!-- folder_contents (pat-structure): plone.icon.contenttype mas portal type normalizado -->
  <record name="plone.icon.contenttype/notificaciotic">
    <field type="plone.registry.field.TextLine">
      <title>ServeiSTIC notificació TIC</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/exclamation-circle-fill.svg</value>
  </record>
  <record name="plone.icon.contenttype/serveitic">
    <field type="plone.registry.field.TextLine">
      <title>ServeiSTIC servei TIC</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/briefcase-fill.svg</value>
  </record>

  <records interface="plone.app.querystring.interfaces.IQueryField"
           prefix="plone.app.querystring.field.servei_facetas">
    <value key="title"
           i18n:translate="">Facetes servei</value>
    <value key="description"
           i18n:translate="">Totes les facetes del servei TIC en un sol camp de cerca</value>
    <value key="enabled">True</value>
    <value key="sortable">False</value>
    <value key="operations">
      <element>plone.app.querystring.operation.selection.any</element>
      <element>plone.app.querystring.operation.selection.all</element>
      <element>plone.app.querystring.operation.selection.none</element>
    </value>
    <value key="vocabulary">genweb.serveistic.vocabularies.servei_facetas</value>
    <value key="group"
           i18n:translate="">Text</value>
  </records>

</registry>
